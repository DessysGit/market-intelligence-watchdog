# .env.example
# Copy this file to a new file named .env and fill in your actual credentials.
#
# IMPORTANT FOR GITHUB ACTIONS:
# When adding these to GitHub Repository Secrets (Settings -> Secrets and variables -> Actions):
# - The "Name" of the secret should be the key (e.g. TELEGRAM_BOT_TOKEN)
# - The "Secret" (value) of the secret should ONLY be the value on the right of the "=" sign.
# - Do NOT include "TELEGRAM_BOT_TOKEN=" or any quotes inside the GitHub Secret value.

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat/User ID to send messages to
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Postgres connection string for storing competitor snapshots
DATABASE_URL=your_postgres_database_url_here

# Gemini API Key for summarizing changes
GEMINI_API_KEY=your_gemini_api_key_here
